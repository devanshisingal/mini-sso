# Mini SSO Environment Configuration Template
ENVIRONMENT=development
DEBUG=false

# Service URLs
ISSUER_URL=http://localhost:8000
IDP_UI_URL=http://localhost:5173
DEMO_APP_URL=http://localhost:5174

# Database Connection (SQLite for local dev, PostgreSQL for Docker Compose)
DATABASE_URL=sqlite:///./mini_sso.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/minisso

# Encryption key for TOTP secrets at rest (AES/Fernet)
SECRET_ENCRYPTION_KEY=mini-sso-master-secret-key-32b-length-at-least

# Administrative API access key (optional header fallback)
ADMIN_API_KEY=mini-sso-default-admin-secret-key

# Session & Token Settings
SESSION_COOKIE_NAME=mini_sso_session
SESSION_MAX_AGE_SECONDS=86400
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
AUTH_CODE_LIFETIME_SECONDS=60
ACCESS_TOKEN_LIFETIME_SECONDS=900
ID_TOKEN_LIFETIME_SECONDS=3600
